# ── STAGING-only env (P1-05) ──
# Отдельные секреты для стейджа. НЕ переиспользовать прод-ключи.
# Использование: скопировать в .env.staging и подключить в docker-compose.staging.yml:
#   env_file:
#     - .env
#     - path: .env.staging
#       required: false     # требует Docker Compose v2.24+
# .env.staging переопределяет одноимённые ключи из .env.

NODE_ENV=staging
BOT_NAME=meemee_official_bot

# Отдельный бот стейджа (НЕ прод-токен). Ротировать при утечке.
BOT_TOKEN=
STAGING_BOT_TOKEN=

# Отдельные ТЕСТОВЫЕ ключи/мерчант платёжек (не прод!)
MERCHANT_ID=
PAYMENT_API=
LAVA_PAYMENT_API=

# Секреты подписи вебхуков (свои для стейджа)
WEBHOOK_PASSWORD_PROCESSING=
LAVA_WEBHOOK_SECRET=

# На стейдже сначала false; включить после валидации подписи реальным вебхуком
WEBHOOK_ENFORCE_AUTH=false
PEER_FORWARD_ENABLED=false
ANALYTICS_TOKEN=
